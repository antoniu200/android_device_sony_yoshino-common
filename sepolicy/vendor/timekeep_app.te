# Read /sys/class/rtc/rtc0/since_epoch
allow system_app sysfs_rtc:dir r_dir_perms;
allow system_app sysfs_rtc:file r_file_perms;

# Write to /data/vendor/time/ats_2
allow system_app vendor_time_data_file:dir create_dir_perms;
allow system_app vendor_time_data_file:file create_file_perms;

# Set persist.vendor.timeadjust
set_prop(system_app, vendor_timekeep_prop);
