typeattribute hal_graphics_composer_default hal_lineage_livedisplay_server;

get_prop(hal_graphics_composer_default, cf_graphics_config_prop)

# Allow HWC to test if Assertive Display is supported
get_prop(hal_graphics_composer_default, qcom_ad_prop)

# Allow HWC to send Assertive Display commands to mm-pp-dpps.
unix_socket_connect(hal_graphics_composer_default, pps, mm-pp-daemon)
